<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration dédiée aux points critiques du package.

    La couverture y est mesurée séparément, avec un seuil plus élevé : une
    régression dans la vérification de signature ou dans le routage coûte une
    facture perdue ou livrée au mauvais dossier, ce qui est un incident
    comptable et non un défaut d'affichage.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Package">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src/Webhook</directory>
            <directory suffix=".php">src/Tenancy</directory>
        </include>
    </source>
</phpunit>
