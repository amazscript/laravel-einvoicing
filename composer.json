{
    "name": "amazscript/laravel-einvoicing",
    "description": "Réception et émission de factures électroniques françaises dans Laravel, via une Plateforme Agréée.",
    "keywords": [
        "laravel",
        "facture-electronique",
        "e-invoicing",
        "iopole",
        "dgfip",
        "factur-x",
        "e-reporting"
    ],
    "homepage": "https://github.com/amazscript/laravel-einvoicing",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Decilap",
            "email": "decilapdenis@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AmazScript\\Einvoicing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmazScript\\Einvoicing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "@php -d pcov.enabled=1 vendor/bin/pest --coverage --min=70",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "test:critical": "@php -d pcov.enabled=1 vendor/bin/pest -c phpunit.critical.xml --coverage --min=85"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmazScript\\Einvoicing\\EinvoicingServiceProvider"
            ],
            "aliases": {
                "Einvoicing": "AmazScript\\Einvoicing\\Facades\\Einvoicing"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/amazscript/laravel-einvoicing/issues",
        "source": "https://github.com/amazscript/laravel-einvoicing",
        "docs": "https://github.com/amazscript/laravel-einvoicing/tree/main/docs"
    }
}
